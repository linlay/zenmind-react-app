{
  "name": "zenmind-app",
  "version": "2.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node ./scripts/worklets/pregenerate.js && expo start",
    "android": "node ./scripts/worklets/pregenerate.js && expo run:android",
    "android:device": "node ./scripts/worklets/pregenerate.js && expo run:android --device",
    "ios": "expo run:ios --device",
    "web": "node ./scripts/worklets/pregenerate.js && expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "test": "node --no-warnings --test --experimental-transform-types scripts/tests/*.test.mts",
    "prettier": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "prettier:fix": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "build": "node ./scripts/worklets/pregenerate.js && expo export",
    "eas-build-post-install": "node ./scripts/worklets/pregenerate.js",
    "kb:build": "node ./scripts/kb/build.js && prettier --write \"doc/kb/**/*.json\"",
    "kb:validate": "node ./scripts/kb/validate.js",
    "kb:check-stale": "node ./scripts/kb/check-stale.js"
  },
  "packageManager": "pnpm@7.33.7",
  "dependencies": {
    "@shopify/flash-list": "2.0.2",
    "@react-navigation/bottom-tabs": "7.16.1",
    "@react-navigation/native": "7.2.4",
    "@react-navigation/native-stack": "7.15.1",
    "drizzle-orm": "0.44.7",
    "expo": "56.0.8",
    "expo-clipboard": "56.0.3",
    "expo-document-picker": "56.0.4",
    "expo-file-system": "56.0.7",
    "expo-image-picker": "56.0.15",
    "expo-notifications": "56.0.15",
    "expo-splash-screen": "56.0.10",
    "expo-sqlite": "56.0.4",
    "expo-updates": "~56.0.18",
    "katex": "0.17.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-mmkv": "3.3.3",
    "react-native": "0.85.3",
    "react-native-enriched-markdown": "0.6.0",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-streamdown": "0.2.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.8.3",
    "react-native-web": "0.21.2",
    "remend": "1.3.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@react-native/metro-config": "0.85.3",
    "@types/react": "19.2.15",
    "@typescript-eslint/eslint-plugin": "8.59.4",
    "@typescript-eslint/parser": "8.59.4",
    "babel-preset-expo": "56.0.14",
    "eslint": "9.39.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "metro": "0.84.4",
    "metro-source-map": "0.84.4",
    "prettier": "3.8.3",
    "react-test-renderer": "19.2.3",
    "react-refresh": "0.14.2",
    "typescript": "6.0.3"
  },
  "private": true
}
