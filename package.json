{
  "name": "zenmind-app",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "brand:sync": "node ./scripts/sync-brand.js",
    "prepare:runtime": "node ./scripts/sync-brand.js && node ./scripts/markdown-preview/pregenerate.js",
    "prepare:bundle": "pnpm prepare:runtime && node ./scripts/worklets/pregenerate.js",
    "start": "pnpm prepare:runtime && expo start",
    "android": "pnpm prepare:runtime && expo run:android",
    "android:zenmind": "BRAND=zenmind pnpm android",
    "android:cutej": "BRAND=cutej pnpm android",
    "android:device": "pnpm prepare:runtime && expo run:android --device",
    "android:device:zenmind": "BRAND=zenmind pnpm android:device",
    "android:device:cutej": "BRAND=cutej pnpm android:device",
    "ios": "pnpm prepare:runtime && expo run:ios --device",
    "ios:zenmind": "BRAND=zenmind pnpm ios",
    "ios:cutej": "BRAND=cutej pnpm ios",
    "web": "pnpm prepare:runtime && expo start --web",
    "typecheck": "pnpm prepare:runtime && tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "test": "pnpm prepare:runtime && node --no-warnings --test --experimental-transform-types scripts/tests/*.test.mts",
    "prettier": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "prettier:fix": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "build": "pnpm prepare:bundle && expo export",
    "build:android": "BRAND=zenmind npx eas-cli build -p android --profile preview-zenmind",
    "build:android:zenmind": "BRAND=zenmind npx eas-cli build -p android --profile preview-zenmind",
    "build:android:cutej": "BRAND=cutej npx eas-cli build -p android --profile preview-cutej",
    "build:ios": "BRAND=zenmind npx eas-cli build -p ios --profile production-zenmind",
    "build:ios:zenmind": "BRAND=zenmind npx eas-cli build -p ios --profile production-zenmind",
    "build:ios:cutej": "BRAND=cutej npx eas-cli build -p ios --profile production-cutej",
    "submit:ios": "BRAND=zenmind npx eas-cli submit -p ios --profile production-zenmind --latest",
    "submit:ios:zenmind": "BRAND=zenmind npx eas-cli submit -p ios --profile production-zenmind --latest",
    "submit:ios:zenmind:ipa": "BRAND=zenmind node ./scripts/submit-ios-ipa.js production-zenmind",
    "submit:ios:cutej": "BRAND=cutej npx eas-cli submit -p ios --profile production-cutej --latest",
    "submit:ios:cutej:ipa": "BRAND=cutej node ./scripts/submit-ios-ipa.js production-cutej",
    "release:ios": "BRAND=zenmind npx eas-cli build -p ios --profile production-zenmind --auto-submit",
    "release:ios:zenmind": "BRAND=zenmind npx eas-cli build -p ios --profile production-zenmind --auto-submit",
    "release:ios:cutej": "BRAND=cutej npx eas-cli build -p ios --profile production-cutej --auto-submit",
    "eas-build-post-install": "pnpm prepare:bundle"
  },
  "packageManager": "pnpm@7.33.7",
  "dependencies": {
    "@shopify/flash-list": "2.0.2",
    "@react-navigation/bottom-tabs": "7.16.1",
    "@react-navigation/native": "7.2.4",
    "@react-navigation/native-stack": "7.15.1",
    "drizzle-orm": "0.44.7",
    "echarts": "6.0.0",
    "expo": "56.0.8",
    "expo-asset": "56.0.16",
    "expo-camera": "56.0.7",
    "expo-clipboard": "56.0.3",
    "expo-document-picker": "56.0.4",
    "expo-file-system": "56.0.7",
    "expo-image-picker": "56.0.15",
    "expo-localization": "56.0.6",
    "expo-notifications": "56.0.15",
    "expo-splash-screen": "56.0.10",
    "expo-sqlite": "56.0.4",
    "expo-updates": "56.0.18",
    "katex": "0.17.0",
    "mermaid": "11.16.0",
    "nativewind": "4.2.6",
    "react-native-css-interop": "0.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-mmkv": "3.3.3",
    "react-native": "0.85.3",
    "react-native-enriched-markdown": "0.6.0",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-streamdown": "0.2.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.8.3",
    "react-native-web": "0.21.2",
    "remend": "1.3.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-react-jsx": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@react-native/metro-config": "0.85.3",
    "@types/react": "19.2.15",
    "@typescript-eslint/eslint-plugin": "8.59.4",
    "@typescript-eslint/parser": "8.59.4",
    "babel-preset-expo": "56.0.14",
    "eslint": "9.39.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "metro": "0.84.4",
    "metro-source-map": "0.84.4",
    "prettier": "3.8.3",
    "react-test-renderer": "19.2.3",
    "react-refresh": "0.14.2",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "patchedDependencies": {
      "react-native-worklets@0.8.3": "patches/react-native-worklets@0.8.3.patch"
    }
  },
  "private": true
}
