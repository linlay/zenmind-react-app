{
  "expo": {
    "name": "zenmind-app",
    "slug": "zenmind-react-app",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EDF1F5",
          "image": "./assets/logo.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "chat-messages",
          "color": "#2f80ed"
        }
      ],
      [
        "react-native-enriched-markdown",
        {
          "enableMath": true
        }
      ],
      "./plugins/withAndroidNdkVersionForSubprojects"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zqfrank.agentterminalapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#031722"
      },
      "usesCleartextTraffic": true,
      "package": "com.zqfrank.agentterminalapp",
      "softwareKeyboardLayoutMode": "adjustResize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "e6cc69ea-7449-44f2-ae7c-69831be52d5c"
      }
    },
    "owner": "zqfrank",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e6cc69ea-7449-44f2-ae7c-69831be52d5c"
    }
  }
}
