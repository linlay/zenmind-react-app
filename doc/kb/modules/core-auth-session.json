{
  "id": "core-auth-session",
  "title": "认证会话与设备令牌",
  "layer": "core",
  "paths": ["src/core/auth"],
  "responsibility": [
    "维护设备登录后的会话状态、设备令牌缓存、冷启动恢复和前台预刷新逻辑。",
    "提供 login、hard refresh、soft refresh、logout 和 useSyncExternalStore 订阅入口，不把认证细节散落到页面层。",
    "在开发态通过 core-debug-logging 打印认证 HTTP 请求、响应和错误。",
    "让 app shell 只消费认证快照，不直接处理 token 解析、持久化和刷新单飞。"
  ],
  "publicEntrypoints": [
